#!/bin/bash
# VPN profile manager backed by vpn.local (gitignored) at the repo root.
#
#   vpn-on [--safe[=MIN]] <profile>   connect in the background (survives closing the terminal)
#   vpn-off [profile]                 disconnect one profile, or all when omitted
#   vpn-status                        list profiles and their connection state
#   vpn confirm <profile>             keep a --safe connection (cancel its automatic rollback)
#
# client = openconnect uses openconnect (--protocol=fortinet) over a TUN device instead of openfortivpn,
# for kernels without PPP (e.g. Debian cloud kernels); it always runs as a split tunnel.
#
# Split tunnel: a profile with `routes` never lets openfortivpn touch the routing table or DNS;
# only the listed subnets go through the tunnel (and `domains` resolve via `dns`, with systemd-resolved).
# --safe arms a root timer that disconnects after MIN minutes (default 3) unless `vpn confirm` runs first,
# so a connection that breaks remote access undoes itself.
#
# vpn-on / vpn-off / vpn-status are symlinks to this script; `vpn on|off|status|confirm` also works.

GREEN="\033[0;32m"
WARNING="\033[0;33m"
ERROR="\033[0;31m"
NC="\033[0m"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
REPO_DIR="$(dirname "$SCRIPT_DIR")"
CREDENTIALS_FILE="${VPN_CREDENTIALS:-$REPO_DIR/vpn.local}"
RUN_DIR="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}"
RUN_DIR="${RUN_DIR%/}/vpn"
CONNECT_TIMEOUT=30
SAFE_DEFAULT_MINUTES=3
# Profile keys handled by this script rather than passed to openfortivpn.
SCRIPT_KEYS="type|client|routes|dns|domains"
# Keys the openconnect client understands (it has no config file, so anything else would be silently ignored).
OPENCONNECT_KEYS="type|client|routes|dns|domains|host|port|username|password|trusted-cert|realm"

die() {
    printf '%b%s%b\n' "$ERROR" "$1" "$NC" >&2
    exit 1
}

check_credentials() {
    [ -f "$CREDENTIALS_FILE" ] || die "Credentials file not found: $CREDENTIALS_FILE (see $REPO_DIR/vpn.example)"

    if git -C "$REPO_DIR" rev-parse --is-inside-work-tree &>/dev/null &&
        ! git -C "$REPO_DIR" check-ignore -q "$CREDENTIALS_FILE"; then
        die "Refusing to run: $CREDENTIALS_FILE is NOT gitignored."
    fi

    local perm
    perm=$(stat -c %a "$CREDENTIALS_FILE" 2>/dev/null || stat -f %Lp "$CREDENTIALS_FILE")
    if [ "$perm" != "600" ] && [ "$perm" != "400" ]; then
        chmod 600 "$CREDENTIALS_FILE"
        printf '%b%s%b\n' "$WARNING" "Fixed permissions of $CREDENTIALS_FILE ($perm -> 600)" "$NC"
    fi
}

list_profiles() {
    awk '/^[[:space:]]*\[.*\][[:space:]]*$/ {
        gsub(/^[[:space:]]*\[[[:space:]]*|[[:space:]]*\][[:space:]]*$/, "")
        print
    }' "$CREDENTIALS_FILE"
}

# Print the key = value lines of a profile section; fails if the section doesn't exist.
profile_body() {
    awk -v want="$1" '
        /^[[:space:]]*[#;]/ || /^[[:space:]]*$/ { next }
        /^[[:space:]]*\[.*\][[:space:]]*$/ {
            name = $0
            gsub(/^[[:space:]]*\[[[:space:]]*|[[:space:]]*\][[:space:]]*$/, "", name)
            in_section = (name == want)
            if (in_section) found = 1
            next
        }
        in_section { print }
        END { exit !found }
    ' "$CREDENTIALS_FILE"
}

profile_value() {
    sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" <<<"$1" | tail -1 | sed 's/[[:space:]]*$//'
}

# Matches the openfortivpn process itself (argv[0] may be an absolute path), not the sudo wrapper.
process_pattern() {
    printf '^[^ ]*openfortivpn -c %s' "$RUN_DIR/$1.conf"
}

# Like process_pattern, for openconnect: it is started with --interface=oc-<profile> as its last argument.
oc_process_pattern() {
    if [ -n "$1" ]; then
        printf '^[^ ]*openconnect .* --interface=oc-%s$' "$1"
    else
        printf '^[^ ]*openconnect .* --interface=oc-'
    fi
}

# openconnect lives in /usr/sbin, which is often not on a regular user's PATH.
openconnect_bin() {
    command -v openconnect || { [ -x /usr/sbin/openconnect ] && printf '%s\n' /usr/sbin/openconnect; }
}

# Exact pattern for `sudo pkill`, kept free of shell/sudoers metacharacters so a NOPASSWD rule can match it
# (see vpn.sudoers.example). The ^ anchor keeps it from matching the sudo/pkill command lines themselves.
kill_pattern() {
    printf '^%s -c %s' "$(command -v openfortivpn)" "$RUN_DIR/$1"
}

is_running() {
    pgrep -f "$(process_pattern "$1")" >/dev/null || pgrep -f "$(oc_process_pattern "$1")" >/dev/null
}

validate_name() {
    [ -n "$1" ] || die "Usage: vpn-on <profile>  (profiles: $(list_profiles | tr '\n' ' '))"
    [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "Invalid profile name: $1"
}

# Split a comma/space separated profile value into one item per line.
split_list() {
    tr ', ' '\n\n' <<<"$1" | sed '/^$/d'
}

ipv4_to_int() {
    local IFS=. a b c d
    read -r a b c d <<<"$1"
    printf '%s' "$(((10#$a << 24) | (10#$b << 16) | (10#$c << 8) | 10#$d))"
}

# Print an IPv4 address or CIDR as a.b.c.d/n; fails on anything else.
normalize_cidr() {
    [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})(/([0-9]{1,2}))?$ ]] || return 1
    local i bits=$((10#${BASH_REMATCH[6]:-32}))
    for i in 1 2 3 4; do
        ((10#${BASH_REMATCH[i]} <= 255)) || return 1
    done
    ((bits <= 32)) || return 1
    local addr
    addr=$(ipv4_to_int "${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.${BASH_REMATCH[3]}.${BASH_REMATCH[4]}")
    # Zero the host bits: `ip route` rejects 10.0.0.5/24.
    addr=$((addr & (0xFFFFFFFF << (32 - bits)) & 0xFFFFFFFF))
    printf '%d.%d.%d.%d/%d' $((addr >> 24 & 255)) $((addr >> 16 & 255)) $((addr >> 8 & 255)) $((addr & 255)) "$bits"
}

# True when two normalized CIDRs share any address.
cidr_overlaps() {
    local m=${1#*/}
    ((${2#*/} < m)) && m=${2#*/}
    (($(ipv4_to_int "${1%/*}") >> (32 - m) == $(ipv4_to_int "${2%/*}") >> (32 - m)))
}

# Validate split-tunnel routes against what keeps this machine reachable; prints them normalized.
check_routes() {
    local name="$1" raw route cidr existing ssh_ip gw_ip
    ssh_ip=$(normalize_cidr "${SSH_CONNECTION%% *}" 2>/dev/null)
    gw_ip=$(normalize_cidr "$(getent ahostsv4 "$3" 2>/dev/null | awk 'NR == 1 { print $1 }')" 2>/dev/null)

    while IFS= read -r raw; do
        cidr=$(normalize_cidr "$raw") || die "[$name] routes: '$raw' is not an IPv4 address or CIDR"
        [ "${cidr#*/}" -ge 8 ] || die "[$name] routes: $cidr is too broad (use /8 or narrower)"
        if [ -n "$ssh_ip" ] && cidr_overlaps "$cidr" "$ssh_ip"; then
            die "[$name] routes: $cidr covers your SSH client ${ssh_ip%/*}; routing it into the tunnel would drop this session"
        fi
        if [ -n "$gw_ip" ] && cidr_overlaps "$cidr" "$gw_ip"; then
            die "[$name] routes: $cidr covers the VPN gateway ${gw_ip%/*}; the tunnel would be routed into itself"
        fi
        if [ "$(uname)" = Linux ]; then
            # Taking over an existing subnet (docker/k8s bridges, the LAN) would break whatever uses it.
            while IFS= read -r route; do
                existing=$(normalize_cidr "${route%% *}") || continue
                cidr_overlaps "$cidr" "$existing" &&
                    die "[$name] routes: $cidr overlaps the existing route '$route'"
            done < <(ip -4 route show table main | grep -v '^default ')
        fi
        printf '%s\n' "$cidr"
    done < <(split_list "$2")
}

# Route the profile's subnets (and DNS domains) through the tunnel interface.
apply_split_tunnel() {
    local ifname="$1" routes="$2" dns="$3" domains="$4" route
    while IFS= read -r route; do
        if [ "$(uname)" = Darwin ]; then
            sudo route -n add -net "$route" -interface "$ifname" >/dev/null || return 1
        else
            sudo ip route replace "$route" dev "$ifname" || return 1
        fi
    done <<<"$routes"

    [ -n "$dns" ] || return 0
    if ! command -v resolvectl >/dev/null || ! systemctl is-active --quiet systemd-resolved; then
        printf '%b%s%b\n' "$WARNING" "dns/domains need systemd-resolved; skipped (use IPs, or add the names to /etc/hosts)" "$NC" >&2
        return 0
    fi
    # Only the listed domains go to the tunnel's DNS; default-route=false keeps every other lookup off it.
    # shellcheck disable=SC2046
    sudo resolvectl dns "$ifname" $(split_list "$dns") &&
        sudo resolvectl domain "$ifname" $(split_list "$domains" | sed 's/^~*/~/') &&
        sudo resolvectl default-route "$ifname" false
}

rollback_unit() {
    printf 'vpn-rollback-%s' "$1"
}

# Disconnect the profile (pkill -f "$3") after $2 minutes unless disarmed.
arm_rollback() {
    local name="$1" minutes="$2" pattern="$3" unit
    command -v systemd-run >/dev/null || die "--safe needs systemd-run (Linux with systemd)"
    unit=$(rollback_unit "$name")
    sudo systemctl stop "$unit.timer" "$unit.service" 2>/dev/null
    sudo systemd-run --quiet --unit "$unit" --on-active="${minutes}min" --timer-property=RemainAfterElapse=no \
        "$(command -v pkill)" -f "$pattern" ||
        die "Failed to arm the rollback timer."
}

# Cancel pending rollbacks for one profile, or all when omitted.
disarm_rollback() {
    command -v systemctl >/dev/null || return 0
    local unit
    unit="$(rollback_unit "${1:-*}").timer"
    systemctl list-units --plain --no-legend "$unit" 2>/dev/null | grep -q . || return 1
    sudo systemctl stop "$unit"
}

vpn_on() {
    local name="" safe_minutes=""
    while [ $# -gt 0 ]; do
        case "$1" in
        --safe) safe_minutes=$SAFE_DEFAULT_MINUTES ;;
        --safe=*) safe_minutes="${1#--safe=}" ;;
        -*) die "Unknown option: $1" ;;
        *) name="$1" ;;
        esac
        shift
    done
    validate_name "$name"
    if [ -n "$safe_minutes" ] && ! [[ "$safe_minutes" =~ ^[1-9][0-9]*$ ]]; then
        die "--safe takes whole minutes, e.g. --safe=5"
    fi

    if is_running "$name"; then
        printf '%b%s%b\n' "$GREEN" "$name is already connected." "$NC"
        return
    fi

    local body
    body=$(profile_body "$name") || die "Profile [$name] not found in $CREDENTIALS_FILE (profiles: $(list_profiles | tr '\n' ' '))"

    local type client
    type=$(profile_value "$body" type)
    case "${type:-fortissl}" in
    fortissl) ;;
    *) die "Unsupported VPN type for [$name]: $type" ;;
    esac
    client=$(profile_value "$body" client)
    case "${client:=openfortivpn}" in
    openfortivpn | openconnect) ;;
    *) die "Unsupported client for [$name]: $client (use openfortivpn or openconnect)" ;;
    esac

    local routes dns domains
    routes=$(profile_value "$body" routes)
    dns=$(profile_value "$body" dns)
    domains=$(profile_value "$body" domains)
    if [ -n "$routes" ]; then
        routes=$(check_routes "$name" "$routes" "$(profile_value "$body" host)") || exit 1
        [ -n "$routes" ] || die "[$name] routes is empty"
        if [[ -n "$dns" && -z "$domains" || -z "$dns" && -n "$domains" ]]; then
            die "[$name] dns and domains must be set together"
        fi
    elif [ "$client" = openconnect ]; then
        die "[$name] client = openconnect only runs as a split tunnel; add routes"
    elif [ -n "$dns$domains" ]; then
        die "[$name] dns/domains only apply to a split tunnel; add routes"
    elif [ -n "$SSH_CONNECTION" ] && [ "$(profile_value "$body" set-routes)" != 0 ]; then
        die "[$name] has no routes, so the gateway may take over the default route and drop this SSH session. Add 'routes = <client subnets>' (or 'set-routes = 0' to manage routes yourself)."
    fi

    local bin kill ifname=""
    if [ "$client" = openconnect ]; then
        local unknown
        unknown=$(sed -E 's/^[[:space:]]*//; s/[[:space:]]*=.*//' <<<"$body" | grep -Evx "$OPENCONNECT_KEYS" | tr '\n' ' ')
        [ -z "$unknown" ] || die "[$name] not supported with client = openconnect: $unknown"
        [ -n "$(profile_value "$body" host)" ] || die "[$name] host is missing"
        # Interface names are limited to 15 characters.
        [ "${#name}" -le 12 ] || die "[$name] profile names are limited to 12 characters with client = openconnect"
        bin=$(openconnect_bin) || die "openconnect not found. Install it: sudo apt install openconnect (Debian/Ubuntu) / sudo pacman -S openconnect (Arch) / brew install openconnect (macOS)"
        ifname="oc-$name"
        kill=$(oc_process_pattern "$name")
    else
        bin=$(command -v openfortivpn) || die "openfortivpn not found. Install it: sudo pacman -S openfortivpn (Arch) / sudo apt install openfortivpn (Debian/Ubuntu) / brew install openfortivpn (macOS)"
        kill=$(kill_pattern "$name.conf")
    fi

    mkdir -p "$RUN_DIR" && chmod 700 "$RUN_DIR"
    local cfg="$RUN_DIR/$name.conf"
    local log="$RUN_DIR/$name.log"

    # Both clients read this only at startup (openfortivpn its config, openconnect the password on stdin),
    # so the plaintext copy is removed once it's up.
    trap "rm -f '$cfg'" EXIT
    (
        umask 077
        if [ "$client" = openconnect ]; then
            profile_value "$body" password
        elif [ -n "$routes" ]; then
            # Split tunnel: whatever the gateway pushes, leave the routing table and resolv.conf alone.
            grep -Ev "^[[:space:]]*($SCRIPT_KEYS|set-routes|set-dns|pppd-use-peerdns)[[:space:]]*=" <<<"$body"
            printf '%s\n' "set-routes = 0" "set-dns = 0" "pppd-use-peerdns = 0"
        else
            grep -Ev "^[[:space:]]*($SCRIPT_KEYS)[[:space:]]*=" <<<"$body"
        fi >"$cfg"
    )

    # With a NOPASSWD rule for openfortivpn, skip the password prompt (sudo -v would still ask for one).
    # dns/domains and --safe run resolvectl/systemd-run as root, so they always need sudo credentials.
    # Split-tunnel routes are added with plain sudo later: no prompt with a NOPASSWD rule for
    # `ip route replace` (see vpn.sudoers.example), otherwise sudo asks then.
    # sudo -v can prompt even with NOPASSWD (when another rule for the user needs a password), so try -n first.
    if ! sudo -n true 2>/dev/null &&
        { [ -n "$dns$safe_minutes" ] || ! sudo -n -l "$bin" -c "$cfg" >/dev/null 2>&1; }; then
        sudo -v || die "sudo authentication failed."
    fi
    if [ -n "$safe_minutes" ]; then
        arm_rollback "$name" "$safe_minutes" "$kill"
    else
        # A leftover --safe timer from an earlier connection would kill this one.
        disarm_rollback "$name"
    fi
    : >"$log"
    if [ "$client" = openconnect ]; then
        # This script stands in for vpnc-script (see oc_script), so openconnect never touches routes or DNS.
        local port args
        port=$(profile_value "$body" port)
        args=(--protocol=fortinet --non-inter --passwd-on-stdin --user="$(profile_value "$body" username)"
            --script="$(printf '%q' "$SCRIPT_DIR/vpn") _oc-script")
        [ -n "$(profile_value "$body" trusted-cert)" ] && args+=(--servercert="$(profile_value "$body" trusted-cert)")
        [ -n "$(profile_value "$body" realm)" ] && args+=(--authgroup="$(profile_value "$body" realm)")
        # --interface must stay last: oc_process_pattern anchors on it.
        nohup sudo -b "$bin" "${args[@]}" "https://$(profile_value "$body" host)${port:+:$port}" \
            --interface="$ifname" <"$cfg" >"$log" 2>&1
    else
        nohup sudo -b "$bin" -c "$cfg" </dev/null >"$log" 2>&1
    fi

    printf '%s' "Connecting to $name"
    local i up=""
    for ((i = 0; i < CONNECT_TIMEOUT * 2; i++)); do
        if [ "$client" = openconnect ]; then
            # oc_script assigns the address once the tunnel is established.
            ip -4 -o addr show dev "$ifname" 2>/dev/null | grep -q ' inet ' && up=1
        else
            grep -q "Tunnel is up and running" "$log" && up=1
        fi
        [ -n "$up" ] && break
        if [ "$i" -ge 4 ] && ! is_running "$name"; then
            break
        fi
        printf '.'
        sleep 0.5
    done
    printf '\n'

    if [ -n "$up" ] && [ -n "$routes" ]; then
        [ -n "$ifname" ] || ifname=$(sed -n 's/.*Interface \(ppp[0-9]*\) is UP.*/\1/p' "$log" | tail -1)
        if [ -z "$ifname" ]; then
            printf '%s\n' "Could not find the tunnel interface in the log." >&2
            up=""
        elif ! apply_split_tunnel "$ifname" "$routes" "$dns" "$domains"; then
            printf '%s\n' "Failed to set up split-tunnel routes/DNS on $ifname." >&2
            up=""
        else
            printf 'Routed via %s: %s\n' "$ifname" "$(tr '\n' ' ' <<<"$routes")"
            [ -n "$domains" ] && printf 'Resolved via %s: %s\n' "$dns" "$domains"
        fi
    fi

    if [ -n "$up" ]; then
        printf '%b%s%b\n' "$GREEN" "$name connected. You can close this terminal; disconnect with: vpn-off $name" "$NC"
        if [ -n "$safe_minutes" ]; then
            printf '%b%s%b\n' "$WARNING" "Auto-disconnect in $safe_minutes min unless you run: vpn confirm $name" "$NC"
        fi
        return
    fi

    [ -n "$safe_minutes" ] && disarm_rollback "$name"
    is_running "$name" && sudo pkill -f "$kill"
    tail -n 20 "$log" >&2
    local pin
    pin=$(grep -o 'pin-sha256:[A-Za-z0-9+/=]*' "$log" | tail -1)
    if [ -n "$pin" ]; then
        printf '%b%s%b\n' "$WARNING" "Gateway certificate is not trusted. If it is expected, add 'trusted-cert = $pin' to [$name] in $CREDENTIALS_FILE" "$NC" >&2
    elif grep -q "trusted-cert" "$log"; then
        printf '%b%s%b\n' "$WARNING" "Gateway certificate is not trusted. If the hash above is expected, add 'trusted-cert = <hash>' to [$name] in $CREDENTIALS_FILE" "$NC" >&2
    fi
    die "Failed to connect to $name (full log: $log)"
}

vpn_off() {
    [ -n "$1" ] && validate_name "$1"
    disarm_rollback "$1"

    local ofv_pattern ofv_kill oc_pattern running=""
    if [ -n "$1" ]; then
        ofv_pattern=$(process_pattern "$1")
        ofv_kill=$(kill_pattern "$1.conf")
    else
        ofv_pattern="^[^ ]*openfortivpn -c $RUN_DIR/"
        ofv_kill=$(kill_pattern "")
    fi
    oc_pattern=$(oc_process_pattern "$1")
    pgrep -f "$ofv_pattern" >/dev/null && running=1 && sudo pkill -f "$ofv_kill"
    pgrep -f "$oc_pattern" >/dev/null && running=1 && sudo pkill -f "$oc_pattern"
    if [ -z "$running" ]; then
        if [ -n "$1" ]; then
            printf '%s\n' "$1 is not connected."
        else
            printf '%s\n' "No VPN is connected."
        fi
        return
    fi

    local i
    for ((i = 0; i < 20; i++)); do
        pgrep -f "$ofv_pattern" >/dev/null || pgrep -f "$oc_pattern" >/dev/null || {
            printf '%b%s%b\n' "$GREEN" "Disconnected ${1:-all VPNs}." "$NC"
            return
        }
        sleep 0.5
    done
    die "The VPN client is still running; check with: pgrep -fl 'openfortivpn|openconnect'"
}

# Called by openconnect (as root) in place of vpnc-script. It only brings the TUN device up with its address;
# routes and DNS are left alone, and vpn_on adds the profile's routes once the address appears.
oc_script() {
    case "$reason" in
    connect)
        ip link set dev "$TUNDEV" up mtu "${INTERNAL_IP4_MTU:-1400}" &&
            ip addr add "$INTERNAL_IP4_ADDRESS/32" dev "$TUNDEV"
        ;;
    esac
}

vpn_status() {
    local name
    while IFS= read -r name; do
        if is_running "$name"; then
            printf '%b● %s%b  connected' "$GREEN" "$name" "$NC"
            if systemctl is-active --quiet "$(rollback_unit "$name").timer" 2>/dev/null; then
                printf '%b  (auto-disconnect pending; vpn confirm %s)%b' "$WARNING" "$name" "$NC"
            fi
            printf '\n'
        else
            printf '○ %s\n' "$name"
        fi
    done < <(list_profiles)
}

vpn_confirm() {
    validate_name "$1"
    is_running "$1" || die "$1 is not connected."
    if disarm_rollback "$1"; then
        printf '%b%s%b\n' "$GREEN" "$1 will stay connected (auto-disconnect cancelled)." "$NC"
    else
        printf '%s\n' "$1 has no pending auto-disconnect."
    fi
}

if [ "$1" = _oc-script ]; then
    oc_script
    exit
fi

case "$(basename "$0")" in
vpn-on) cmd=on ;;
vpn-off) cmd=off ;;
vpn-status) cmd=status ;;
*)
    cmd="$1"
    shift
    ;;
esac

check_credentials

case "$cmd" in
on) vpn_on "$@" ;;
off) vpn_off "$1" ;;
status) vpn_status ;;
confirm) vpn_confirm "$1" ;;
*) die "Usage: vpn on [--safe[=MIN]] <profile> | vpn off [profile] | vpn status | vpn confirm <profile>" ;;
esac
