#!/bin/bash
# Launch Steam with fcitx5 working in its UI (see scripts/steam-fcitx5/README.md).
# Rebuilds the patched module when fcitx5-gtk changed; if it still is not safe for the
# installed Steam runtime, launches plain Steam rather than risk a crashing UI.

build="$(dirname "$(readlink -f "$0")")/../scripts/steam-fcitx5/build.sh"
out="$HOME/.local/share/steam-fcitx5"

if ! "$build" --check 2>/dev/null; then
    "$build" >/dev/null || true
fi

if "$build" --check; then
    exec env GTK_IM_MODULE=fcitx GTK_IM_MODULE_FILE="$out/immodules.cache" /usr/bin/steam "$@"
fi

notify-send -u critical "Steam 輸入法未啟用" "steam-fcitx5 檢查沒過，這次用原版 Steam 啟動。修法見 dotfiles/scripts/steam-fcitx5/README.md" 2>/dev/null
exec /usr/bin/steam "$@"
