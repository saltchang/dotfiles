# Lets bin/vpn connect/disconnect without a sudo password.
# Install: replace <user> and <uid> (see `id -u`) and check the openfortivpn and ip paths (`command -v openfortivpn ip`), then
#   sudo visudo -f /etc/sudoers.d/vpn
# Note: openfortivpn config can load pppd plugins as root, so this effectively grants root to the user.
# The ip rules let split-tunnel profiles (`routes`) add their routes; they allow routing any subnet into a
# VPN interface, but nothing beyond that. `dns`/`domains` and `vpn-on --safe` also run resolvectl/systemd-run
# as root, so those still ask for the sudo password.
<user> ALL=(root) NOPASSWD: /usr/sbin/openfortivpn -c /run/user/<uid>/vpn/*.conf, \
    /usr/bin/pkill -f ^/usr/sbin/openfortivpn -c /run/user/<uid>/vpn/*, \
    /usr/bin/ip route replace * dev ppp[0-9]*, \
    /usr/bin/ip route replace * dev oc-*
